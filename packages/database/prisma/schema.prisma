// RisingBrain — Prisma schema.
// See docs/ARCHITECTURE.md for the design rationale behind every model.
//
// Conventions:
//   - cuid() ids, snake_case table names via @@map, camelCase fields.
//   - Content is published server-side and cached in Redis; user state (progress,
//     notes, activity) is per-user and merged on the server.
//   - Auth session state lives primarily in Redis; the Session model is the
//     durable audit record (see ARCHITECTURE.md §1).

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  NORMAL
  STUDENT
  SUBSCRIBER
  ADMIN
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
  GITHUB
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum ProblemStatus {
  NOT_STARTED
  IN_PROGRESS
  SOLVED
}

enum QuizKind {
  APTITUDE
  LOGICAL_REASONING
  PUZZLE
}

enum CourseLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum CourseTag {
  DSA
  SQL
  SYSTEM_DESIGN
  LLD
  APTITUDE
  INTERVIEW
  CHALLENGE
}

enum LessonType {
  VIDEO
  ARTICLE
  QUIZ
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  REFUNDED
}

enum SubscriptionPlan {
  FREE
  PRO
  PREMIUM
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

enum InterviewVerdict {
  SELECTED
  REJECTED
  PENDING
}

// The moderation lifecycle of a user-authored post. Only PUBLISHED is publicly
// readable; everything else is visible to its author and to admins.
//
//   DRAFT          reserved (nothing writes it yet)
//   PENDING_REVIEW submitted, waiting in the admin approval queue  ← default
//   PUBLISHED      approved by an admin; live on the feed
//   REJECTED       turned down; the author sees `reviewNote` and can resubmit
//   ARCHIVED       removed (author-deleted or admin-archived); a tombstone that
//                  keeps other people's replies instead of cascading them away
enum PublishStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  REJECTED
  ARCHIVED
}

// No DOMAIN member: a Domain practice question is an MCQ like a Screening one, so
// `/api/domain/submit` logs it as MCQ rather than splitting the same kind of event
// across two enum values (and two heatmap columns). Domain topics DO produce
// submissions — they stopped being read-only notes when practice sets landed.
enum SubmissionType {
  DSA_PROBLEM
  MCQ
  COURSE_LESSON
}

// ============================================================================
// AUTH & USERS
// ============================================================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  // Optional for now (kept from the legacy DB); needed for the upcoming paid
  // course launch. Not unique yet — make it @unique only if/when it becomes a
  // login identifier (phone OTP), since that also needs a verified-phone flow.
  phoneNumber   String?
  image         String?
  // Null for OAuth-only accounts. argon2id hash when set.
  passwordHash  String?
  role          Role      @default(NORMAL)

  // Set by an admin to disable an account: blocks login / OAuth / refresh and the
  // user's live sessions are revoked. Null = active. See admin users management.
  disabledAt DateTime?

  // Denormalized streak/heatmap summary (IST day boundaries; see streak logic).
  currentStreak Int       @default(0)
  longestStreak Int       @default(0)
  lastActiveOn  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  oauthAccounts     OAuthAccount[]
  sessions          Session[]
  subscription      Subscription?
  progress          UserProblemProgress[]
  quizProgress      UserQuizProgress[]
  quizScores        UserQuizTopicScore[]
  domainProgress    UserDomainQuizProgress[]
  domainScores      UserDomainTopicScore[]
  notes             UserProblemNote[]
  submissions       Submission[]
  activityDays      ActivityDay[]
  enrollments       Enrollment[]
  interviews        InterviewExperience[] @relation("InterviewAuthor")
  // Posts this user moderated. Only ever non-empty for admins; it exists so a
  // decision on the approval queue is attributable to whoever made it.
  interviewReviews  InterviewExperience[] @relation("InterviewReviewer")
  interviewLikes    InterviewLike[]
  interviewComments InterviewComment[]
  feedback          Feedback[]            @relation("FeedbackAuthor")
  // Feedback this user has marked read. Only ever non-empty for admins.
  feedbackReviews   Feedback[]            @relation("FeedbackReviewer")

  @@index([role])
  @@map("users")
}

// Linked OAuth identities (Google, GitHub). Credentials use User.passwordHash.
model OAuthAccount {
  id                String       @id @default(cuid())
  userId            String
  provider          AuthProvider
  providerAccountId String
  createdAt         DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("oauth_accounts")
}

// Durable audit record of a login session. Live validation happens in Redis
// (session:{id}); this row survives a Redis flush and powers "your devices".
// Single-active-session is enforced in app logic by revoking prior sessions.
model Session {
  id          String    @id @default(cuid())
  userId      String
  // sha256 of the current (rotating) refresh token. Never store the raw token.
  refreshHash String    @unique
  // sha256 of the refresh token this row's current one REPLACED, honoured until
  // `prevRefreshExpiresAt`. Rotation-on-every-use races with itself — two tabs, or
  // the edge proxy's refresh bounce landing next to a SessionKeepAlive ping, can
  // present the same token within a few hundred ms. Without a grace window the
  // loser resolves to "unknown token" and is hard logged out.
  //
  // This USED to live only in Redis (`rtprev:{hash}`), which meant a Redis outage
  // silently removed the protection and turned every refresh race into a logout.
  // Keeping it on the authoritative row makes the grace window survive the outage.
  prevRefreshHash      String?   @unique
  prevRefreshExpiresAt DateTime?
  userAgent   String?
  ip          String?
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime  @default(now())
  expiresAt   DateTime
  revokedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

// Subscription state. SUBSCRIBER role is granted while status = ACTIVE.
model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               SubscriptionPlan   @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  provider           String? // e.g. "razorpay", "stripe"
  externalId         String? // provider subscription id
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([currentPeriodEnd])
  @@map("subscriptions")
}

// ============================================================================
// SHARED CONTENT
// ============================================================================

model Company {
  id       String           @id @default(cuid())
  name     String           @unique
  slug     String           @unique
  logoUrl  String?
  problems ProblemCompany[]

  @@map("companies")
}

// ============================================================================
// DSA SHEETS  (DsaSheet -> DsaTopic -> DsaPattern -> DsaProblem)
// ============================================================================

model DsaSheet {
  id          String     @id @default(cuid())
  slug        String     @unique
  name        String
  description String?
  order       Int        @default(0)
  isPublished Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  topics      DsaTopic[]

  @@map("dsa_sheets")
}

model DsaTopic {
  id          String       @id @default(cuid())
  sheetId     String
  name        String
  slug        String
  description String?
  order       Int          @default(0)
  sheet       DsaSheet     @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  patterns    DsaPattern[]

  @@unique([sheetId, slug])
  @@index([sheetId])
  @@map("dsa_topics")
}

// A "pattern" is the demo's subtopic: carries the teaching strategy + the cue
// for when to identify/apply it.
model DsaPattern {
  id             String       @id @default(cuid())
  topicId        String
  name           String
  slug           String
  strategy       String?
  identification String?
  order          Int          @default(0)
  topic          DsaTopic     @relation(fields: [topicId], references: [id], onDelete: Cascade)
  problems       DsaProblem[]

  @@unique([topicId, slug])
  @@index([topicId])
  @@map("dsa_patterns")
}

model DsaProblem {
  id          String     @id @default(cuid())
  patternId   String
  // Stable human slug used by progress/notes/heatmap references.
  slug        String     @unique
  title       String
  reference   String? // e.g. "LC 167"
  difficulty  Difficulty @default(MEDIUM)
  leetcodeUrl String?
  gfgUrl      String?
  youtubeUrl  String?
  order       Int        @default(0)

  pattern   DsaPattern            @relation(fields: [patternId], references: [id], onDelete: Cascade)
  companies ProblemCompany[]
  progress  UserProblemProgress[]
  notes     UserProblemNote[]

  @@index([patternId])
  @@index([difficulty])
  @@map("dsa_problems")
}

model ProblemCompany {
  problemId String
  companyId String
  problem   DsaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([problemId, companyId])
  @@index([companyId])
  @@map("problem_companies")
}

// ============================================================================
// DOMAIN  (core-CS interview subjects: SQL, DBMS, OS, CN, OOPS) — unified notes
// ============================================================================

// The discriminating "key" that keeps every Domain section in one table.
enum DomainSubject {
  SQL
  DBMS
  OS
  CN
  OOPS
}

// One study topic inside a subject. The content is a single markdown field,
// `notes` — theory, inline diagrams and copy-ready code examples all in the one
// body (there used to be a separate `example` column behind a second tab; the
// examples were folded into the notes so a topic reads top to bottom). Topics
// are bucketed into the left-nav sections by `groupLabel` (e.g. a phase / unit /
// module). Shared, seeded, cookie-free content: cached cross-request and tagged
// for revalidation (CACHE_TAGS.domainCatalog), never merged with per-user state.
//
// `questions` is the topic's own MCQ set, shown in the "Practice" tab beside the
// notes — see DomainQuestion.
//
// `miniProject` is an optional third tab, "Mini Project": a hands-on design
// challenge (the course PDFs call it the "Boss Challenge") with its hint and a
// possible solution, in markdown. Null for topics that don't have one, and the
// tab is simply not shown — so CN / DBMS / OS / SQL are unaffected.
model DomainTopic {
  id          String        @id @default(cuid())
  subject     DomainSubject
  slug        String
  title       String
  groupLabel  String // left-nav section header, e.g. "Module 6 — Transactions & Concurrency"
  groupOrder  Int           @default(0)
  summary     String? // one-line subtitle
  notes       String // markdown: theory + inline diagrams + code examples
  miniProject String? // markdown: the "Mini Project" tab; null = no tab
  order       Int           @default(0)
  isPublished Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  questions DomainQuestion[]
  scores    UserDomainTopicScore[]

  @@unique([subject, slug])
  @@index([subject])
  @@map("domain_topics")
}

// ============================================================================
// DOMAIN PRACTICE  — the Domain section's own MCQ instance
// ============================================================================
//
// Deliberately SEPARATE from the Screening quiz models (QuizQuestion /
// UserQuizProgress / UserQuizTopicScore) rather than a nullable branch off
// them. The two are different products: Screening drills aptitude topics that
// exist only to be practised, while Domain questions hang off a study topic
// whose main content is its notes. Sharing one table would mean every screening
// query filtering on "which kind is this" forever, and a learner's Screening
// score is not their Domain score.
//
// The difference in shape is real too: screening questions carry a `hint` and
// forfeit the mark when it is opened. Domain questions have no hints — the
// source material puts its explanation after the answer instead — so a mark is
// simply a correct answer.

model DomainQuestion {
  id          String      @id @default(cuid())
  topicId     String
  prompt      String // markdown
  // options: Json array of { "key": "a", "label": "..." }
  options     Json
  answerKey   String // matches one option key, e.g. "a"
  explanation String? // revealed only in post-submit review
  difficulty  Difficulty?
  order       Int         @default(0)

  topic    DomainTopic              @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress UserDomainQuizProgress[]

  @@index([topicId])
  @@map("domain_questions")
}

// Per-user, per-question outcome — written ONLY when a topic's practice set is
// submitted (not per answer). One row per (user, question); re-attempting
// replaces it. Mirrors UserQuizProgress including its non-destructive
// re-attempt rule: a new attempt upserts the answered rows and flips any
// previously-answered-but-now-skipped rows inactive instead of deleting them.
model UserDomainQuizProgress {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  selectedKey String
  isCorrect   Boolean
  isActive    Boolean  @default(true)
  answeredAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  question DomainQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("user_domain_quiz_progress")
}

// The stored "mark" for a topic's practice set — one row per (user, topic),
// replaced on re-attempt. `score` = correct answers at last submit, `total` =
// question count at that time.
model UserDomainTopicScore {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  score       Int
  total       Int
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic DomainTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@map("user_domain_topic_scores")
}

// ============================================================================
// QUIZ  (Aptitude / Logical Reasoning / Puzzles)  — unified MCQ model
// ============================================================================

model QuizCategory {
  id     String      @id @default(cuid())
  kind   QuizKind
  slug   String      @unique
  name   String
  order  Int         @default(0)
  topics QuizTopic[]

  @@map("quiz_categories")
}

model QuizTopic {
  id         String               @id @default(cuid())
  categoryId String
  name       String
  // Globally unique, not just per-category: this slug IS the URL segment for
  // /screening/<slug> and /puzzles/<slug>, and those two routes share one topic
  // table, so a slug has to identify a topic on its own.
  slug       String               @unique
  theory     String? // optional topic theory / notes
  formula    String? // optional key formulae
  order      Int                  @default(0)
  category   QuizCategory         @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  questions  QuizQuestion[]
  scores     UserQuizTopicScore[]

  @@index([categoryId])
  @@map("quiz_topics")
}

model QuizQuestion {
  id          String             @id @default(cuid())
  topicId     String
  prompt      String // markdown; holds syllogism statements/conclusions too
  // options: Json array of { "key": "a", "label": "..." }
  options     Json
  answerKey   String // matches one option key, e.g. "a"
  explanation String? // revealed only in post-submit review
  hint        String? // method nudge, shippable to the client (never the answer)
  difficulty  Difficulty?
  order       Int                @default(0)
  topic       QuizTopic          @relation(fields: [topicId], references: [id], onDelete: Cascade)
  progress    UserQuizProgress[]

  @@index([topicId])
  @@map("quiz_questions")
}

// Per-user, per-question outcome — written ONLY when a topic's test is submitted
// (not per answer). One row per (user, question); re-attempting the test replaces
// the row. `isCorrect` is the latest outcome; `hintUsed` = the hint was opened
// before answering; `awarded` = isCorrect && !hintUsed (the mark earned).
model UserQuizProgress {
  id          String   @id @default(cuid())
  userId      String
  questionId  String
  selectedKey String
  isCorrect   Boolean
  hintUsed    Boolean  @default(false)
  awarded     Boolean  @default(false)
  // Non-destructive re-attempts: a new attempt upserts the answered rows and
  // marks any previously-answered-but-now-skipped rows inactive instead of
  // deleting them. Reads (progress seed, awarded counts) filter isActive.
  isActive    Boolean  @default(true)
  answeredAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("user_quiz_progress")
}

// The stored "mark" for a topic's test — one row per (user, topic), replaced on
// re-attempt. `score` = number of awarded questions at last submit; `total` =
// question count at that time. Powers the module progress shown in the nav/paper.
model UserQuizTopicScore {
  id          String   @id @default(cuid())
  userId      String
  topicId     String
  score       Int
  total       Int
  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic QuizTopic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@index([userId])
  @@map("user_quiz_topic_scores")
}

// ============================================================================
// COURSES  (Instructor -> Course -> CourseModule -> CourseLesson + Enrollment)
// ============================================================================

model Instructor {
  id      String   @id @default(cuid())
  slug    String   @unique
  name    String
  bio     String?
  image   String?
  links   Json? // { linkedin, youtube, instagram, ... }
  courses Course[]

  @@map("instructors")
}

model Course {
  id              String      @id @default(cuid())
  slug            String      @unique
  title           String
  blurb           String?
  descriptionLong String?
  icon            String? // lucide icon name
  level           CourseLevel @default(BEGINNER)
  tag             CourseTag   @default(DSA)
  priceInPaise    Int         @default(0) // 0 = free
  currency        String      @default("INR")
  isFree          Boolean     @default(true)
  rating          Float?
  learnersLabel   String? // e.g. "32k"
  lessonCount     Int         @default(0)
  durationHours   Float       @default(0)
  isPublished     Boolean     @default(false)
  order           Int         @default(0)
  instructorId    String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  instructor  Instructor?    @relation(fields: [instructorId], references: [id])
  modules     CourseModule[]
  enrollments Enrollment[]

  @@index([tag])
  @@index([isPublished])
  @@map("courses")
}

model CourseModule {
  id       String         @id @default(cuid())
  courseId String
  title    String
  order    Int            @default(0)
  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessons  CourseLesson[]

  @@index([courseId])
  @@map("course_modules")
}

model CourseLesson {
  id            String           @id @default(cuid())
  moduleId      String
  title         String
  type          LessonType       @default(VIDEO)
  durationLabel String? // e.g. "08:24"
  videoUrl      String?
  contentUrl    String?
  isPreview     Boolean          @default(false)
  order         Int              @default(0)
  module        CourseModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progress      LessonProgress[]

  @@index([moduleId])
  @@map("course_lessons")
}

model Enrollment {
  id              String           @id @default(cuid())
  userId          String
  courseId        String
  status          EnrollmentStatus @default(ACTIVE)
  progressPercent Int              @default(0)
  enrolledAt      DateTime         @default(now())
  completedAt     DateTime?

  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  course         Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@map("enrollments")
}

model LessonProgress {
  id           String       @id @default(cuid())
  enrollmentId String
  lessonId     String
  completedAt  DateTime     @default(now())
  enrollment   Enrollment   @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, lessonId])
  @@index([enrollmentId])
  @@map("lesson_progress")
}

// ============================================================================
// INTERVIEW EXPERIENCES
// ============================================================================

model InterviewExperience {
  id          String           @id @default(cuid())
  authorId    String
  company     String
  role        String
  verdict     InterviewVerdict @default(PENDING)
  difficulty  Difficulty       @default(MEDIUM)
  roundsCount Int              @default(1)
  title       String
  // URL segment for /interview/<slug>. Readable title + a short opaque token,
  // e.g. "google-l4-strong-start-fell-short-on-the-dp-round-k3f9x2". The token is
  // what makes it unique, so two posts may share a title and an edited title can
  // regenerate the readable half while the row keeps a stable identity.
  slug        String           @unique
  excerpt     String?
  body        String // markdown
  tags        String[]
  // Submissions land in the approval queue, NOT on the feed: anyone with an
  // account can post here, so every write-up is admin-reviewed before it is
  // publicly readable. An edit sends the row back to PENDING_REVIEW (see
  // `PATCH /api/interview/[id]`) — otherwise "get approved, then swap the body"
  // would be a trivial way around the review.
  status      PublishStatus    @default(PENDING_REVIEW)
  likeCount   Int              @default(0) // denormalized; InterviewLike is truth

  // --- moderation trail (null until an admin has ruled on the row) ---
  reviewedAt   DateTime?
  reviewedById String?
  // Why it was rejected. Shown to the AUTHOR on their own post, so it is written
  // as feedback ("add the round-by-round questions"), not an internal note.
  reviewNote   String?

  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  author     User               @relation("InterviewAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting an admin account must not delete the posts
  // they once approved.
  reviewedBy User?              @relation("InterviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  likes      InterviewLike[]
  comments   InterviewComment[]

  // Browse/feed access paths. The list is always filtered by `status` and then
  // sorted, so each index is a (status, …filter, …sortkey) composite that lets
  // Postgres satisfy the WHERE + ORDER BY + LIMIT from a single index range scan
  // — no full-table scan or sort even as the table grows large.
  @@index([status, createdAt(sort: Desc)]) // default "Newest" sort
  @@index([status, likeCount(sort: Desc), createdAt(sort: Desc)]) // "Top" sort
  @@index([status, verdict, createdAt(sort: Desc)]) // verdict tab + Newest
  @@index([tags], type: Gin) // tag membership search (`tags has …`)
  // The admin queue reads one status oldest-first; the (status, createdAt) index
  // above serves it by scanning the same range forwards.
  @@index([authorId, status]) // "my submissions" strip on /interview
  @@index([reviewedById])
  @@index([company])
  @@map("interview_experiences")
}

model InterviewLike {
  id           String   @id @default(cuid())
  userId       String
  experienceId String
  // Likes are a toggle: unliking flips isActive=false (the row is reused on a
  // re-like) instead of deleting. `InterviewExperience.likeCount` is recomputed
  // from the count of active likes on every toggle, so the counter never drifts.
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  experience InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)

  @@unique([userId, experienceId])
  @@index([experienceId, isActive])
  @@map("interview_likes")
}

model InterviewComment {
  id           String   @id @default(cuid())
  experienceId String
  authorId     String
  body         String
  createdAt    DateTime @default(now())

  experience InterviewExperience @relation(fields: [experienceId], references: [id], onDelete: Cascade)
  author     User                @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([experienceId])
  @@index([authorId])
  @@map("interview_comments")
}

// ============================================================================
// PER-USER STATE: progress, notes, heatmap
// ============================================================================

model UserProblemProgress {
  id           String        @id @default(cuid())
  userId       String
  problemId    String
  status       ProblemStatus @default(NOT_STARTED)
  isBookmarked Boolean       @default(false)
  solvedAt     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem DsaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([userId, status])
  @@index([userId, isBookmarked])
  @@map("user_problem_progress")
}

model UserProblemNote {
  id        String   @id @default(cuid())
  userId    String
  problemId String
  content   String // markdown
  // Clearing a note flips isActive=false (row retained, re-activated on re-add)
  // instead of deleting. The "has note" indicator reads isActive.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  problem DsaProblem @relation(fields: [problemId], references: [id], onDelete: Cascade)

  @@unique([userId, problemId])
  @@index([userId])
  @@index([userId, isActive])
  @@map("user_problem_notes")
}

// Append-only log of every "task" the user submits/completes. Feeds ActivityDay.
model Submission {
  id          String         @id @default(cuid())
  userId      String
  type        SubmissionType
  referenceId String // id/slug of the problem, question, or lesson
  createdAt   DateTime       @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("submissions")
}

// Pre-aggregated per-day counts powering the LeetCode-style heatmap. One row per
// (user, day); incremented atomically on each submission. The profile heatmap is
// a single indexed range scan over this table.
model ActivityDay {
  id          String   @id @default(cuid())
  userId      String
  day         DateTime @db.Date // IST calendar day
  count       Int      @default(0) // total contributions that day (sum of the columns below)
  // Per-kind counts as explicit columns (not a Json blob) so each can be
  // incremented atomically via Prisma `{ increment }` — a Json field would
  // require read-modify-write and lose updates under concurrent same-day writes.
  dsaCount    Int      @default(0)
  mcqCount    Int      @default(0)
  courseCount Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
  @@index([userId])
  @@map("activity_days")
}

// ============================================================================
// PRODUCT FEEDBACK
// ============================================================================

// Where one piece of feedback sits in the admin's inbox.
//
//   NEW    nobody has read it yet — it counts against the author's open quota
//   VIEWED an admin has read it; the author's quota frees up again
enum FeedbackStatus {
  NEW
  VIEWED
}

// A note a signed-in user sends from the floating widget. Deliberately thin:
// one body, one author, one read/unread flag. There is no reply thread — the
// point is a low-friction "here's what's broken", not a support system.
//
// The body is markdown (converted from the widget's rich-text HTML on write, the
// same way an interview experience is), so one renderer serves both.
model Feedback {
  id     String         @id @default(cuid())
  userId String
  body   String // markdown
  // 1–5 stars, optional: the widget can be opened to report a bug, where a
  // score is noise, and the nudge can be answered with a star before anyone has
  // typed a word. Null means "not given", NOT zero — averaging it as 0 would
  // drag the score down every time someone only reported a broken page.
  rating Int?
  // A user may hold at most FEEDBACK_PENDING_LIMIT rows in NEW at once (see
  // `lib/feedback.ts`). That is the rate limit: it is cleared by an admin
  // reading the feedback, not by waiting, so the quota tracks "how much unread
  // work this person has queued" rather than elapsed time.
  status FeedbackStatus @default(NEW)

  // --- read trail (null until an admin has opened it) ---
  reviewedAt   DateTime?
  reviewedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("FeedbackAuthor", fields: [userId], references: [id], onDelete: Cascade)
  // SetNull, not Cascade: deleting an admin account must not delete the feedback
  // they once read.
  reviewedBy User? @relation("FeedbackReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  // The admin inbox reads one status newest-first; the quota check counts
  // (userId, status = NEW). Both are single index range scans.
  @@index([status, createdAt(sort: Desc)])
  @@index([userId, status])
  @@index([reviewedById])
  @@map("feedback")
}
